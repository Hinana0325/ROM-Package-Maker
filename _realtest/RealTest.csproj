<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RomRealTest</RootNamespace>
  </PropertyGroup>

  <!-- 直接编译主项目服务层源码（与 _selftest 一致），用于真机样本验证 -->
  <ItemGroup>
    <Compile Include="..\RomPackageMaker\Core\*.cs" />
    <Compile Include="..\RomPackageMaker\Engine\*.cs" />
    <Compile Include="..\RomPackageMaker\Application\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>
</Project>
