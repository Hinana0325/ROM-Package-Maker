# 统一行尾处理
* text=auto

# 源码
*.cs text diff=csharp
*.xaml text
*.csproj text
*.xml text

# 脚本与配置
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.yml text
*.yaml text
*.json text
*.editorconfig text
*.gitignore text
*.gitattributes text
*.md text

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.zip binary
*.img binary
