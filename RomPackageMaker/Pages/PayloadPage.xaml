<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RomPackageMaker.Pages.PayloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RomPackageMaker.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:RomPackageMaker.Engine"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Payload / OTA 提取" />

        <!-- 源文件 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox
                x:Name="SourceBox"
                Width="440"
                Header="payload.bin 或 OTA 刷机包 zip"
                IsReadOnly="True"
                PlaceholderText="选择文件" />
            <Button
                VerticalAlignment="Bottom"
                Click="BrowseSourceButton_Click"
                Content="浏览..." />
            <Button
                x:Name="ParseButton"
                VerticalAlignment="Bottom"
                Click="ParseButton_Click"
                Content="解析"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- 输出目录 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox
                x:Name="OutputBox"
                Width="440"
                Header="输出目录（提取出的分区镜像 .img）"
                IsReadOnly="True"
                PlaceholderText="选择输出目录" />
            <Button
                VerticalAlignment="Bottom"
                Click="BrowseOutputButton_Click"
                Content="浏览..." />
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Click="SelectAllButton_Click" Content="全选" />
            <Button Click="SelectNoneButton_Click" Content="全不选" />
            <Button
                x:Name="ExtractButton"
                Click="ExtractButton_Click"
                Content="提取选中分区"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Click="CancelButton_Click"
                Content="取消"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="HintText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="尚未解析。提取出的 .img 可在「解包」页继续处理。" />
        </StackPanel>

        <!-- 进度 -->
        <StackPanel
            Grid.Row="4"
            MaxWidth="640"
            HorizontalAlignment="Left"
            Spacing="4">
            <TextBlock
                x:Name="StageText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="就绪" />
            <ProgressBar x:Name="ExtractProgress" Maximum="100" Value="0" />
        </StackPanel>

        <!-- 分区列表 -->
        <Border
            Grid.Row="5"
            Padding="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6,12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Width="24" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="分区" />
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="大小" />
                    <TextBlock
                        Grid.Column="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="操作数 / 状态" />
                </Grid>

                <ListView
                    x:Name="PartList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Parts, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:PayloadPartitionInfo">
                            <Grid
                                Padding="12,4,12,4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    IsEnabled="{x:Bind IsSupported, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SizeText, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusLine, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
