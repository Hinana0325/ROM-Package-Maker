<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RomPackageMaker.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RomPackageMaker.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,20,24,24" HorizontalScrollMode="Disabled" HorizontalAlignment="Stretch">
        <Grid RowSpacing="16" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Hero 头部：品牌色渐变（紧凑） ===== -->
            <Border
                Grid.Row="0"
                Padding="24,20"
                Background="{StaticResource HeroGradientBrush}"
                CornerRadius="16">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="White" Text="ROM 制作工具" />
                        <TextBlock
                            MaxWidth="720"
                            FontSize="13"
                            Foreground="#CCFFFFFF"
                            LineHeight="20"
                            TextWrapping="Wrap"
                            Text="Android ROM 解包、定制与打包的本地化工作台。内置 ext4 / sparse / boot.img / super 动态分区解析与重打包引擎，支持刷机包 zip 签名。" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        MinWidth="280"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Padding="12,10"
                        Background="#26FFFFFF"
                        CornerRadius="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="WorkspaceStatusIcon" VerticalAlignment="Center" FontSize="14" Foreground="White" Glyph="&#xE8B7;" />
                            <TextBlock
                                x:Name="WorkspaceStatusText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#E6FFFFFF"
                                Text="尚未选择工作目录"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="OpenWorkspaceButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="OpenWorkspaceButton_Click"
                                Content="打开"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 下方左右分栏 ===== -->
            <Grid Grid.Row="1" ColumnSpacing="16" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：快速操作 + 使用提示 -->
                <Grid Grid.Column="0" RowSpacing="10" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderTextBlockStyle}" Text="快速操作" />

                    <!-- 磁贴 3x2 -->
                    <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button HorizontalAlignment="Stretch" Click="NavUnpack_Click" Style="{StaticResource CompactCardButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource BrandLightBrush}" CornerRadius="9">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8C8;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="解包" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="解出可编辑目录" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="NavPack_Click" Style="{StaticResource CompactCardButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource BrandLightBrush}" CornerRadius="9">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8EF;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="打包" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="重建镜像并签名" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="NavQueue_Click" Style="{StaticResource CompactCardButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource BrandLightBrush}" CornerRadius="9">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE7A8;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="任务队列" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="查看进行中任务" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="NavInfo_Click" Style="{StaticResource CompactCardButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource BrandLightBrush}" CornerRadius="9">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE9D9;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="信息总览" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="分区与系统信息" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="NavBuildProp_Click" Style="{StaticResource CompactCardButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource BrandLightBrush}" CornerRadius="9">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE70F;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="定制 ROM" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="build.prop 编辑" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="NavTemplates_Click" Style="{StaticResource CompactCardButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource BrandLightBrush}" CornerRadius="9">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8FD;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="定制模板" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Text="一键应用预设" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 使用提示 -->
                    <Border Grid.Row="2" Padding="14,12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="使用提示" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                LineHeight="18"
                                TextWrapping="Wrap"
                                Text="1. 在「解包」页载入刷机包 zip 或分区镜像，选择输出目录后开始解包。&#x0a;2. 解包完成后，各定制页面（Build.prop、精简、ROOT 等）会自动跟随工作目录。&#x0a;3. 定制完成后在「打包」页重建镜像并输出签名 zip；也可使用「任务队列」批量处理。" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 右侧：工作流程（垂直） -->
                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderTextBlockStyle}" Text="工作流程" />
                    <StackPanel Grid.Row="1" Spacing="8">
                        <Border Padding="12,10" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" VerticalAlignment="Center" Background="{ThemeResource BrandBrush}" CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White" Text="1" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="解包" />
                                </StackPanel>
                                <TextBlock Margin="30,0,0,0" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" LineHeight="16" TextWrapping="Wrap" Text="载入刷机包 zip 或分区镜像，解出可编辑的工作目录。" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12,10" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" VerticalAlignment="Center" Background="{ThemeResource BrandBrush}" CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White" Text="2" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="定制" />
                                </StackPanel>
                                <TextBlock Margin="30,0,0,0" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" LineHeight="16" TextWrapping="Wrap" Text="修改 build.prop、精简预装、集成 ROOT，或一键应用定制模板。" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12,10" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" VerticalAlignment="Center" Background="{ThemeResource BrandBrush}" CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White" Text="3" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="打包" />
                                </StackPanel>
                                <TextBlock Margin="30,0,0,0" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" LineHeight="16" TextWrapping="Wrap" Text="重新生成分区镜像，输出可刷写的签名 zip 刷机包。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
