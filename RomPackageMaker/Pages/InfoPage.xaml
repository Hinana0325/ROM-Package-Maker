<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RomPackageMaker.Pages.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RomPackageMaker.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:RomPackageMaker.Application"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ROM 信息总览" />

        <!-- 工作目录 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox
                x:Name="WorkspaceBox"
                Width="440"
                VerticalAlignment="Center"
                Header="工作目录（需已解包）"
                IsReadOnly="True"
                PlaceholderText="选择解包工作目录" />
            <Button
                x:Name="BrowseWorkspaceButton"
                VerticalAlignment="Bottom"
                Click="BrowseWorkspaceButton_Click"
                Content="浏览..." />
            <Button
                x:Name="ScanButton"
                VerticalAlignment="Bottom"
                Click="ScanButton_Click"
                Content="扫描信息"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12" Margin="0,0,12,8">
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="选择解包工作目录后点击「扫描信息」，汇总属性 / 分区 / 应用 / GMS / AVB / ROOT 状态。" />

                <!-- 状态摘要卡 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" Text="ROM 状态" />
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="预装应用" />
                                <TextBlock x:Name="StatApps" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Google 服务（GMS）" />
                                <TextBlock x:Name="StatGms" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="AVB / dm-verity" />
                                <TextBlock x:Name="StatAvb" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="ROOT（su 痕迹）" />
                                <TextBlock x:Name="StatRoot" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="分区数" />
                                <TextBlock x:Name="StatPartitions" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="镜像总大小" />
                                <TextBlock x:Name="StatTotalSize" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="来源类型" />
                                <TextBlock x:Name="StatSourceType" FontSize="18" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="来源文件" />
                                <TextBlock
                                    x:Name="StatSourceFile"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分区列表卡 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" Text="分区镜像" />
                        <ListView
                            x:Name="PartitionList"
                            MaxHeight="180"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:RomInfoPartition">
                                    <Grid
                                        Padding="12,6,12,6"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ImageType}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SparseText}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            FontFamily="Consolas"
                                            Text="{x:Bind SizeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- 系统属性卡 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" Text="系统属性（合并全部 build.prop，system 优先）" />
                        <ListView
                            x:Name="PropList"
                            MaxHeight="320"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:RomInfoProp">
                                    <Grid
                                        Padding="12,6,12,6"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            Text="{x:Bind Key}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Description}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            Text="{x:Bind Value}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Value}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Source}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
